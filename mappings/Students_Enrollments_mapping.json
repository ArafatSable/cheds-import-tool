      "kind": "map",
      "value_map": {
        "M": "Male",
        "F": "Female",
        "U": "Unreported due to privacy laws applicable (e.g. GDPR , FERPA)"
      },
      "_note": "HEDB Gender codes."
    },
    {
      "raw_column": "Enroll_Student_DOB",
      "target_field": "Student_DOB",
      "kind": "date",
      "_note": "yyyy-mm-dd."
    },
    {

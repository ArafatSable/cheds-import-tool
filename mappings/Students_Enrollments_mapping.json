{
  "_form_note": "Students_Enrollments, rebuilt for HEDB 202601 against Zoho_To_CHEDS_(23).ds form fields + push workflow 'push_api_production10'. Raw columns = 2026 Database Field Names (incl. the new Grad_Second_Program_code). Removed vs the old mapping because they are no longer in the 2026 dataset or on the form: Al_Ethbara, Family_Book_Number, Family_Number, City_Number, Marital_Status, Area_of_Specialization, Student_Major (text), Major CIP, Language test date/score, Standardized test score, HS/HE equivalency numbers. Long numeric values (Emirates ID etc.) are written as text by the engine.",
  "fields": [
    {
      "raw_column": "Enroll_Institution_Code",
      "target_field": "Institution_Code",
      "kind": "lookup",
      "lookup_direction": "code_to_name",
      "hedb_sheet": "Institutional Codes",
      "_note": "141 -> institution Name (displayformat [Name]). Push hardcodes institutionCode=141."
    },
    {
      "raw_column": "Enroll_Institution_Name",
      "target_field": null,
      "kind": "unmapped",
      "_note": "Redundant with Enroll_Institution_Code. Not imported."
    },
    {
      "raw_column": "Enroll_Academic_Period",
      "target_field": "Academic_Period",
      "kind": "plain",
      "_note": "Form displayformat = [Code] -> the raw code is imported unchanged. e.g. 202601."
    },
    {
      "raw_column": "Enroll_Student_ID",
      "target_field": "Student_ID",
      "kind": "plain",
      "_note": "No conversion."
    },
    {
      "raw_column": "Enroll_Emirates_ID",
      "target_field": "Emirates_ID",
      "kind": "plain",
      "_note": "Text field. Long numbers are written as TEXT by the tool so all 15 digits survive (no 7.84E+14 truncation). 999999999999999 if not available."
    },
    {
      "raw_column": "Enroll_Passport_Number",
      "target_field": "Passport_Number",
      "kind": "plain",
      "_note": "No conversion. 'NA' if not available."
    },
    {
      "raw_column": "Enroll_Missing_EID",
      "target_field": "Reason_why_Emirates_ID_is_missing",
      "kind": "map",
      "value_map": {
        "GCC": "GCC Resident with no Emirates ID",
        "VISITING": "Visiting Student/Staff",
        "ONLINE": "Distance Learning Student Or Faculty teaching online only (outside of UAE) or staff working remotely",
        "NEW": "New student/faculty and Emirates ID is applied for",
        "MAR": "Students with UAE passport but not UAE Nationals (Marsoom)",
        "PRLW": "Emirates ID cannot be provided as GDPR/FERP",
        "DPL": "Family of diplomats. Do not required emirates ID"
      },
      "_note": "HEDB 'Reason for Missing EID' codes -> exact form text. NOTE PRLW label is truncated on the form ('...GDPR/FERP') and Dropdown_Fields.Reason_why_Missing doesn't recognise it -- see findings."
    },
    {
      "raw_column": "Enroll_Student_Name_English",
      "target_field": "Student_Name_English",
      "kind": "plain",
      "_note": "No conversion."
